# Never commit ROM material or anything derived from it (CLAUDE.md hard rule).
*.z64
*.n64
*.v64
*.rom
*.eep
*.sra
*.fla
*.mpk
baserom*
*_uncompressed*
rom/
roms/

# recompiler output and anything generated from a ROM
RecompiledFuncs/
RecompiledPatches/
gen/
rsp/*.c
rsp/*.cpp
*.syms.generated.toml

# build output, releases, caches
/build/
/build-xbox*/
/build-host/
/out*/
/dist/
/.n64rx/
__pycache__/
*.pyc
*.profraw

# built images, saves, console dumps, emulator firmware
*.xbe
*.xiso
*.iso
*.img
*.qcow2
*.bmp

# fetched trees (submodules live in tools/recomp; anything else fetched goes here)
/external/

# agent worktrees, editors
/.claude/
.DS_Store
build-sweep/
/build-*/

# the desktop app (app/): dependencies, staged sources, installers, the generated icon
/app/node_modules/
/app/dist/
/app/stage/
/app/build/icon.png
/app/build/icon.ico
/app/build/icon.icns
/app/renderer/img/
/app/renderer/mark-stars.js

# archives (a ROM zipped is still a ROM), saves, and what the learning loop and the analysis keep
*.zip
*.7z
*.gz
*.xz
*.bz2
*.rar
*.srm
*.sav
learn_code.bin
learn.txt
analysis.cache
