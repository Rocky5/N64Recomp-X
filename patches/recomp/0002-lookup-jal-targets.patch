+// N64Recomp-X (patches/recomp/0002-lookup-jal-targets.md): [patches] lookup_jal = [vram, ...]
+std::vector<uint32_t> get_lookup_jal_targets(const toml::table* patches_data) {
+    std::vector<uint32_t> out{};
+    const toml::node_view data = (*patches_data)["lookup_jal"];
+    if (data.is_array()) {
+        data.as_array()->for_each([&out](auto&& el) {
+            if constexpr (toml::is_integer<decltype(el)>) {
+                out.push_back((uint32_t)*el);
+            } else {
+                throw toml::parse_error("Invalid lookup_jal entry", el.source());
+            }
+        });
+    } else if (data) {
+        throw toml::parse_error("lookup_jal is not an array", data.node()->source());
+    }
+    return out;
+}
